rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Slug : 3 à 32 caractères (a-z, 0-9, tirets), sans tiret au début/à la fin, hors mots réservés
    function validSlug(s) {
      return s.matches('^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$')
        && !(s in ['admin', 'api', 'login', 'logout', 'auth', 'app', 'dashboard', 'index',
                   'about', 'terms', 'privacy', 'help', 'support', 'discord', 'static', 'serveurs', 'servers']);
    }

    // Rang déclaré par l'utilisateur pour un serveur : 0 = visiteur, 1 = gestionnaire, 2 = propriétaire
    function claimRank(g) {
      return exists(/databases/$(database)/documents/claims/$(request.auth.uid + '_' + g))
        ? get(/databases/$(database)/documents/claims/$(request.auth.uid + '_' + g)).data.rank
        : 0;
    }

    // Catégories de l'annuaire
    function validCat(c) {
      return c in ['gaming', 'communaute', 'anime', 'musique', 'art', 'code', 'etudes', 'entraide', 'roleplay', 'bot', 'autre'];
    }

    // Admin : le code saisi doit être identique à celui du document config/admin (jamais lisible par le site)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.code
           == get(/databases/$(database)/documents/config/admin).data.code;
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;   // quitter le mode admin
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string
        && request.resource.data.code == get(/databases/$(database)/documents/config/admin).data.code;
    }

    // Rang déclaré (connexion Discord) : un document par utilisateur et par serveur
    match /claims/{id} {
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'guildId', 'rank'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.guildId is string
        && request.resource.data.guildId.matches('^[0-9]{15,22}$')
        && id == request.auth.uid + '_' + request.resource.data.guildId
        && request.resource.data.rank in [1, 2];
    }

    match /links/{slug} {
      // Lecture d'un lien précis : publique (nécessaire pour la redirection des visiteurs)
      allow get: if true;

      // Lister : utilisateur connecté (liens à moi + liens de mes serveurs)
      allow list: if request.auth != null;

      // Création : connecté (anonyme suffit), n'importe quel serveur, slug valide et libre
      allow create: if request.auth != null
        && validSlug(slug)
        && request.resource.data.keys().hasOnly(['slug', 'invite', 'guildId', 'guildName', 'guildIcon', 'ownerUid', 'ownerDiscordId', 'ownerName', 'ownerRank', 'expireAt', 'createdAt'])
        && request.resource.data.keys().hasAll(['slug', 'invite', 'guildName', 'ownerUid', 'createdAt'])
        && request.resource.data.slug == slug
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.invite is string
        && request.resource.data.invite.matches('^https://discord\\.gg/[A-Za-z0-9-]{2,32}$')
        && request.resource.data.guildName is string
        && request.resource.data.guildName.size() >= 1
        && request.resource.data.guildName.size() <= 100
        && (!('guildId' in request.resource.data)
            || (request.resource.data.guildId is string && request.resource.data.guildId.matches('^[0-9]{15,22}$')))
        && (!('ownerDiscordId' in request.resource.data)
            || (request.resource.data.ownerDiscordId is string && request.resource.data.ownerDiscordId.matches('^[0-9]{15,22}$')))
        && (!('guildIcon' in request.resource.data) || request.resource.data.guildIcon == null
            || (request.resource.data.guildIcon is string && request.resource.data.guildIcon.size() <= 64))
        && (!('ownerName' in request.resource.data) || (request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 100))
        && (!('ownerRank' in request.resource.data)
            || (request.resource.data.ownerRank in [0, 1, 2]
                && (request.resource.data.ownerRank == 0
                    || ('guildId' in request.resource.data
                        && claimRank(request.resource.data.guildId) >= request.resource.data.ownerRank))))
        // Sans connexion Discord : le lien expire (7 jours, 10 max). Avec connexion Discord : pas d'expiration.
        && (('ownerDiscordId' in request.resource.data)
            ? !('expireAt' in request.resource.data)
            : ('expireAt' in request.resource.data
               && request.resource.data.expireAt is timestamp
               && request.resource.data.expireAt > request.time
               && request.resource.data.expireAt <= request.time + duration.value(10, 'd')))
        && request.resource.data.createdAt == request.time;

      // Pas de modification : on supprime puis on recrée
      allow update: if false;

      // Suppression : le créateur, ou quelqu'un de rang supérieur sur ce serveur
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid
            || isAdmin()
            || (resource.data.get('expireAt', null) != null && resource.data.expireAt < request.time)   // lien expiré : n'importe qui peut le nettoyer
            || claimRank(resource.data.get('guildId', '')) > resource.data.get('ownerRank', 0));
    }

    // Notifications : « ton lien a été remplacé » (uniquement pour un lien créé avec un compte Discord).
    // Créée AVANT la suppression du lien : les règles vérifient que le lien existe encore, qu'il appartient bien
    // à cette personne Discord et que l'auteur a un rang supérieur (ou est admin).
    match /notifications/{id} {
      allow get, list: if request.auth != null;
      allow delete: if request.auth != null;   // « OK » = on supprime la notification
      allow update: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['toDiscordId', 'slug', 'guildName', 'byName', 'byRank', 'createdAt'])
        && request.resource.data.keys().hasAll(['toDiscordId', 'slug', 'guildName', 'byName', 'byRank', 'createdAt'])
        && request.resource.data.toDiscordId is string
        && request.resource.data.toDiscordId.matches('^[0-9]{15,22}$')
        && request.resource.data.slug is string
        && request.resource.data.guildName is string && request.resource.data.guildName.size() >= 1 && request.resource.data.guildName.size() <= 100
        && request.resource.data.byName is string && request.resource.data.byName.size() >= 1 && request.resource.data.byName.size() <= 100
        && request.resource.data.byRank in [0, 1, 2, 3]
        && exists(/databases/$(database)/documents/links/$(request.resource.data.slug))
        && get(/databases/$(database)/documents/links/$(request.resource.data.slug)).data.get('ownerDiscordId', null) == request.resource.data.toDiscordId
        && (isAdmin()
            || claimRank(get(/databases/$(database)/documents/links/$(request.resource.data.slug)).data.get('guildId', ''))
               > get(/databases/$(database)/documents/links/$(request.resource.data.slug)).data.get('ownerRank', 0))
        && request.resource.data.createdAt == request.time;
    }

    // Annuaire de serveurs : un document par serveur (id = identifiant Discord du serveur => pas de doublon)
    match /servers/{gid} {
      allow get, list: if true;   // l'annuaire est public

      allow create: if request.auth != null
        && gid.matches('^[0-9]{15,22}$')
        && request.resource.data.keys().hasOnly(['guildId', 'name', 'icon', 'invite', 'description', 'category', 'category2', 'memberCount', 'ownerUid', 'ownerDiscordId', 'ownerName', 'ownerRank', 'createdAt'])
        && request.resource.data.keys().hasAll(['guildId', 'name', 'invite', 'description', 'category', 'ownerUid', 'ownerDiscordId', 'ownerRank', 'createdAt'])
        && request.resource.data.guildId == gid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100
        && request.resource.data.invite is string
        && request.resource.data.invite.matches('^https://discord\\.gg/[A-Za-z0-9-]{2,32}$')
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10 && request.resource.data.description.size() <= 300
        && validCat(request.resource.data.category)
        // 2e catégorie facultative (max 2 au total), différente de la première
        && (!('category2' in request.resource.data)
            || (validCat(request.resource.data.category2) && request.resource.data.category2 != request.resource.data.category))
        && (!('icon' in request.resource.data) || request.resource.data.icon == null
            || (request.resource.data.icon is string && request.resource.data.icon.size() <= 64))
        && (!('memberCount' in request.resource.data)
            || (request.resource.data.memberCount is int && request.resource.data.memberCount >= 0))
        && (!('ownerDiscordId' in request.resource.data)
            || (request.resource.data.ownerDiscordId is string && request.resource.data.ownerDiscordId.matches('^[0-9]{15,22}$')))
        && (!('ownerName' in request.resource.data) || (request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 100))
        // Seulement MES serveurs : connexion Discord obligatoire + rang propriétaire (2) ou gestionnaire (1) sur CE serveur
        && request.resource.data.ownerRank in [1, 2]
        && claimRank(gid) >= request.resource.data.ownerRank
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      // Retrait : celui qui l'a ajouté, un admin, ou quelqu'un de rang supérieur sur ce serveur
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid
            || isAdmin()
            || claimRank(gid) > resource.data.get('ownerRank', 0));
    }

    // Tout le reste est interdit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
